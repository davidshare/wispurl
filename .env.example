# Auth service
# Each service logs in as its own least-privilege role (db/init/create-service-roles.sh).
AUTH_DATABASE_URL=postgresql+psycopg://auth_svc:replace-with-auth-db-password@postgres:5432/auth_db
AUTH_SERVICE_URL=http://auth-service:8000

# Shortener service
SHORTENER_DATABASE_URL=postgresql+psycopg://shortener_svc:replace-with-shortener-db-password@postgres:5432/short_db
SHORTENER_SERVICE_URL=http://shortener-service:8000

# Analytics service
ANALYTICS_DATABASE_URL=postgresql+psycopg://analytics_svc:replace-with-analytics-db-password@postgres:5432/stats_db
ANALYTICS_SERVICE_URL=http://analytics-service:8000
MILESTONES=100,1000,10000

# Internal service-to-service auth (Shortener -> Analytics /events)
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
ANALYTICS_REQUEST_TIMEOUT=2

# Rate limiter service
RATE_LIMITER_URL=http://rate-limiter-service:8000
WINDOW_SECONDS=3600
CREATE_LINK_LIMIT=20
RATE_LIMITER_REQUEST_TIMEOUT=1
RATE_LIMITER_FAIL_OPEN=true

# QR service
QR_SERVICE_URL=http://qr-service:8000
# Base URL encoded into QR images (the public gateway entry point).
PUBLIC_BASE_URL=http://localhost:8080
MIN_SIZE_PX=64
MAX_SIZE_PX=1024
DEFAULT_SIZE_PX=256
CACHE_TTL=86400

# Shared auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Gateway
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_CONNECT_TIMEOUT=5
REQUEST_READ_TIMEOUT=30

# Frontend (baked into the client bundle at build time; the URL the BROWSER uses)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Used at runtime by the Next auth route handlers (server -> gateway, internal network)
GATEWAY_INTERNAL_URL=http://gateway:8000

# Shared infrastructure
REDIS_URL=redis://redis:6379/0
# Non-default creds: RabbitMQ's "guest" user only connects from localhost, so
# services on the Docker network must use a real user. URL must match the creds below.
RABBITMQ_URL=amqp://appuser:apppass@rabbitmq:5672/

# Event flow (Shortener producer, Analytics consumer)
EVENTS_PUBLISH_ENABLED=true
ANALYTICS_HTTP_FALLBACK=false

# Cleanup service (may only read expired links and mark them inactive)
CLEANUP_DATABASE_URL=postgresql+psycopg://cleanup_svc:replace-with-cleanup-db-password@postgres:5432/short_db
CLEANUP_INTERVAL_SECONDS=60
BATCH_SIZE=500

# Notification service
NOTIFY_CHANNEL=log

# Local backing stores
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Read-only role for the PostgreSQL metrics exporter (db/init/create-monitoring-role.sh)
POSTGRES_MONITOR_PASSWORD=replace-with-a-long-random-monitor-password
# Per-service database logins. Use the same values inside the *_DATABASE_URL lines above.
POSTGRES_AUTH_PASSWORD=replace-with-auth-db-password
POSTGRES_SHORTENER_PASSWORD=replace-with-shortener-db-password
POSTGRES_ANALYTICS_PASSWORD=replace-with-analytics-db-password
POSTGRES_CLEANUP_PASSWORD=replace-with-cleanup-db-password
RABBITMQ_DEFAULT_USER=appuser
RABBITMQ_DEFAULT_PASS=apppass
