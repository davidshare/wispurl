          "expr": "(sum (rate(http_requests_total{service=\"gateway\",status=~\"5..\"}[$__rate_interval])) or sum (rate(http_requests_total{service=\"gateway\"}[$__rate_interval])) * 0) / sum (rate(http_requests_total{service=\"gateway\"}[$__rate_interval]))",
