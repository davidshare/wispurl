          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(loki_request_duration_seconds_bucket{route=~\"loki_api_v1_.*\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false
