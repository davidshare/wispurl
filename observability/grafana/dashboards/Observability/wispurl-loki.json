      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(loki_compactor_apply_retention_last_successful_run_timestamp_seconds)",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
