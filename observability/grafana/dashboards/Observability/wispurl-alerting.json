    "wispurl",
    "wispurl-observability"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "All WispURL dashboards",
      "type": "dashboards",
      "tags": [
        "wispurl"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Observability",
      "type": "dashboards",
      "tags": [
        "wispurl-observability"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
