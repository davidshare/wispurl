{
  "uid": "wispurl-postgres",
  "title": "PostgreSQL",
  "description": "Connections, transactions, cache efficiency, size and locks per database.",
  "tags": [
    "wispurl",
    "wispurl-infrastructure"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "All WispURL dashboards",
      "type": "dashboards",
      "tags": [
        "wispurl"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Infrastructure",
      "type": "dashboards",
      "tags": [
        "wispurl-infrastructure"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_stat_database_xact_commit, datname)",
          "refId": "database",
          "qryType": 1
        },
        "definition": "label_values(pg_stat_database_xact_commit, datname)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "regex": "/^(?!template).*/",
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
