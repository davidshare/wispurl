    {
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Share of reads served from memory. Below ~99% on a small database means memory pressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.9,
                "color": "orange"
              },
              {
                "value": 0.99,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=~\"$database\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{datname=~\"$database\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=~\"$database\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
