    {
      "type": "stat",
      "title": "Longest transaction",
      "description": "Long transactions hold locks and block cleanup. WispURL kills idle-in-transaction sessions after 60 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 30,
                "color": "orange"
              },
              {
                "value": 60,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_stat_activity_max_tx_duration{datname=~\"$database\"})",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
