{
  "uid": "wispurl-containers",
  "title": "Containers",
  "description": "CPU, memory and disk per container (cAdvisor). Per-container network traffic isn't available under Docker Desktop.",
  "tags": [
    "wispurl",
    "wispurl-infrastructure"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "All WispURL dashboards",
      "type": "dashboards",
      "tags": [
        "wispurl"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Infrastructure",
      "type": "dashboards",
      "tags": [
        "wispurl-infrastructure"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{name!=\"\"}, container_label_com_docker_compose_project)",
          "refId": "project",
          "qryType": 1
        },
        "definition": "label_values(container_memory_working_set_bytes{name!=\"\"}, container_label_com_docker_compose_project)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"$project\", name!=\"\"}, name)",
          "refId": "container",
          "qryType": 1
        },
        "definition": "label_values(container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"$project\", name!=\"\"}, name)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "All containers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Containers",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "CPU (cores)"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Memory"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Disk read"
              },
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Disk write"
              },
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Running for"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "CPU (cores)",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=~\"$project\", name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"$project\", name=~\"$container\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_fs_reads_bytes_total{container_label_com_docker_compose_project=~\"$project\", name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_fs_writes_bytes_total{container_label_com_docker_compose_project=~\"$project\", name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (time() - container_start_time_seconds{container_label_com_docker_compose_project=~\"$project\", name=~\"$container\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "name",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E"
              ]
            }
          }
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 10
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Usage over time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
