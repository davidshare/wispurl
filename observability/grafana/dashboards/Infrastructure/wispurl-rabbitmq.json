    {
      "type": "gauge",
      "title": "Memory vs limit",
      "description": "At 100% RabbitMQ blocks publishers until memory frees up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.75,
                "color": "orange"
              },
              {
                "value": 0.9,
                "color": "red"
              }
            ]
