{
  "uid": "wispurl-workers",
  "title": "Workers & Messaging",
  "description": "Queue depth, processing outcomes, retries and dead-lettering, publishing, and each worker's resources and logs.",
  "tags": [
    "wispurl",
    "wispurl-applications"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "All WispURL dashboards",
      "type": "dashboards",
      "tags": [
        "wispurl"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Applications",
      "type": "dashboards",
      "tags": [
        "wispurl-applications"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "worker",
        "label": "Worker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"docker-compose-services\", compose_service=~\"analytics-consumer-service|cleanup-service|notification-service\"}, compose_service)",
          "refId": "worker",
          "qryType": 1
        },
        "definition": "label_values(up{job=\"docker-compose-services\", compose_service=~\"analytics-consumer-service|cleanup-service|notification-service\"}, compose_service)",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 1,
        "regex": ""
      },
      {
        "name": "queue",
        "label": "Queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(rabbitmq_detailed_queue_messages, queue)",
          "refId": "queue",
          "qryType": 1
        },
        "definition": "label_values(rabbitmq_detailed_queue_messages, queue)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "error,critical,warning,info,debug",
        "options": [
          {
            "text": "error",
            "value": "error",
            "selected": false
          },
          {
            "text": "critical",
            "value": "critical",
            "selected": false
          },
          {
            "text": "warning",
            "value": "warning",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "debug",
            "value": "debug",
            "selected": false
          }
        ],
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
