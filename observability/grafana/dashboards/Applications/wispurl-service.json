{
  "uid": "wispurl-service",
  "title": "Service Detail",
  "description": "Everything about one HTTP service: RED metrics per route, dependencies, business events, resources, logs and traces.",
  "tags": [
    "wispurl",
    "wispurl-applications"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "All WispURL dashboards",
      "type": "dashboards",
      "tags": [
        "wispurl"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Applications",
      "type": "dashboards",
      "tags": [
        "wispurl-applications"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total, service)",
          "refId": "service",
          "qryType": 1
        },
        "definition": "label_values(http_requests_total, service)",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 1,
        "regex": ""
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total{service=\"$service\"}, path)",
          "refId": "route",
          "qryType": 1
        },
        "definition": "label_values(http_requests_total{service=\"$service\"}, path)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "error,critical,warning,info,debug",
        "options": [
          {
            "text": "error",
            "value": "error",
            "selected": false
          },
          {
            "text": "critical",
            "value": "critical",
            "selected": false
          },
          {
            "text": "warning",
            "value": "warning",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "debug",
            "value": "debug",
            "selected": false
          }
        ],
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Golden signals for $service",
