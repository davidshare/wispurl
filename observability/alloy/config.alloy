// =============================================================================
// 1. Remote write
// =============================================================================

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}


// =============================================================================
// 2. Docker discovery
// =============================================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}


// =============================================================================
// 3. Docker metrics discovery
//
// Scrapes only containers that:
//   - belong to the app network (WISPURL_NETWORK, set in compose.observability.yaml)
//   - declare prometheus.io/scrape=true
//   - declare a numeric prometheus.io/port
// =============================================================================

discovery.relabel "metrics" {
  targets = discovery.docker.containers.targets

  // 1. Keep only containers on the app network
  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = sys.env("WISPURL_NETWORK")
    action        = "keep"
  }

  // 2. Keep only containers marked for scraping
  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_scrape"]
    regex         = "^true$"
    action        = "keep"
  }

  // 3. Keep only containers with a valid port label
  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_port"]
    regex         = "^[0-9]+$"
    action        = "keep"
  }

  // 4. Drop IPv6 port bindings to prevent duplicate targets per container
  rule {
    source_labels = ["__meta_docker_port_public_ip"]
    regex         = "^::$"
    action        = "drop"
  }

  // 5. Scrape the container's own IP on the app network (e.g. 172.18.0.7:8000).
  //    A Compose service name would resolve to any one replica, so scaled
  //    services would be sampled at random instead of scraped individually.
  rule {
    source_labels = [
      "__meta_docker_network_ip",
      "__meta_docker_container_label_prometheus_io_port",
    ]
    regex        = "^(.+);([0-9]+)$"
    target_label = "__address__"
    replacement  = "$1:$2"
  }

  // 6. Honour a custom prometheus.io/path. Containers without the label fall
  //    back to the scrape's metrics_path (/metrics).
  rule {
    source_labels = ["__meta_docker_container_label_prometheus_io_path"]
    regex         = "^(/.+)$"
    target_label  = "__metrics_path__"
    replacement   = "$1"
  }

  // 7. Extract clean container name (removes the leading slash)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/(.+)$"
    target_label  = "container"
    replacement   = "$1"
  }

  // 7b. Use the container name as instance: it survives restarts, the IP doesn't.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/(.+)$"
    target_label  = "instance"
    replacement   = "$1"
  }

  // 8. Add compose service label
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "^(.+)$"
    target_label  = "compose_service"
    replacement   = "$1"
  }

  // 9. Add static labels
  rule {
    target_label = "environment"
    replacement  = "docker"
  }

  rule {
    target_label = "application"
    replacement  = "wispurl"
  }
}

prometheus.scrape "docker_services" {
  targets         = discovery.relabel.metrics.output
  job_name        = "docker-compose-services"
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}


// =============================================================================
// 4. Docker logs to Loki
// =============================================================================

discovery.relabel "logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = sys.env("WISPURL_NETWORK")
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/(.+)$"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "^(.+)$"
    target_label  = "service"
    replacement   = "$1"
  }

  // Python services opt in to JSON parsing with the label logging.wispurl/format=python.
  rule {
    source_labels = ["__meta_docker_container_label_logging_wispurl_format"]
    regex         = "^(.+)$"
    target_label  = "log_format"
    replacement   = "$1"
  }

  rule {
    target_label = "environment"
    replacement  = "docker"
  }

  rule {
    target_label = "application"
    replacement  = "wispurl"
  }
}

loki.source.docker "wispurl" {
  host = "unix:///var/run/docker.sock"

  targets = discovery.relabel.logs.output

  relabel_rules = discovery.relabel.logs.rules

  forward_to = [loki.process.wispurl.receiver]
}

loki.process "wispurl" {
  forward_to = [loki.write.loki.receiver]

  // 4a. Drop probe noise (healthchecks and scrapes in access logs) first, line by
  //     line, so a probe line can never be glued onto a real error below.
  stage.drop {
    expression          = "(GET|HEAD) /(health|ready|live|metrics)\\b"
    drop_counter_reason = "probe_noise"
  }

  // 4b. Python services: a crash prints a plain-text traceback over many lines.
  //     Glue those lines onto the line that started them, so one error is one
  //     log entry. New entries start with "{" (JSON) or "[2026-..." (Gunicorn).
  stage.match {
    selector = "{log_format=\"python\"}"

    stage.multiline {
      firstline     = "^(\\{|\\[\\d{4}-\\d{2}-\\d{2} )"
      max_wait_time = "3s"
      max_lines     = 500
    }
  }

  // 4c. Redact secrets in every container's logs before they leave this host.
  //     The apps already scrub known secret fields; this is the safety net.
  stage.replace {
    expression = "(?i)bearer\\s+([A-Za-z0-9._~+/-]+=*)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)"
    replace    = "[REDACTED_JWT]"
  }

  // Passwords inside connection URLs: the text between "user:" and "@host".
  stage.replace {
    expression = "[a-zA-Z][a-zA-Z0-9+.-]*://[^:/@\\s\"]+:([^@/\\s\"]+)@"
    replace    = "[REDACTED]"
  }

  // password=..., "token": "...", api_key: ...
  stage.replace {
    expression = "(?i)\"?(?:password|passwd|secret|api[_-]?key|token)\"?\\s*[:=]\\s*\"?([^\"\\s,}]+)"
    replace    = "[REDACTED]"
  }

  // Vault tokens (hvs./hvb./hvr. prefixes).
  stage.replace {
    expression = "(hv[sbr]\\.[A-Za-z0-9_-]{20,})"
    replace    = "[REDACTED_VAULT_TOKEN]"
  }

  // 4d. Python services: pull fields out of the JSON log line.
  stage.match {
    selector = "{log_format=\"python\"}"

    stage.json {
      expressions = {
        level      = "level",
        request_id = "request_id",
        trace_id   = "trace_id",
        span_id    = "span_id",
      }
    }

    // Gunicorn's own lines are plain text: "[2026-10-17 13:30:37 +0000] [1] [INFO] ..."
    stage.regex {
      expression = "^\\[[^\\]]+\\] \\[\\d+\\] \\[(?P<gunicorn_level>[A-Z]+)\\]"
    }

    // One lowercase level for both formats.
    stage.template {
      source   = "level"
      template = "{{ if .Value }}{{ ToLower .Value }}{{ else if .gunicorn_level }}{{ ToLower .gunicorn_level }}{{ end }}"
    }

    // level has a handful of values, so it is a label (indexed, cheap to filter).
    stage.labels {
      values = {
        level = "",
      }
    }

    // IDs are unique per request. As labels they would create one stream per
    // request and overwhelm Loki, so they go in structured metadata instead.
    stage.structured_metadata {
      values = {
        request_id = "",
        trace_id   = "",
        span_id    = "",
      }
    }
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}


// =============================================================================
// 5. OTLP traces: FastAPI/Python services -> Alloy -> Tempo
// =============================================================================

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// Group spans into batches before sending: fewer, larger requests to Tempo.
otelcol.processor.batch "default" {
  timeout = "5s"

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}


// =============================================================================
// 6. Redis metrics
// =============================================================================

prometheus.exporter.redis "redis" {
  redis_addr = "redis:6379"
}

prometheus.scrape "redis" {
  targets         = prometheus.exporter.redis.redis.targets
  job_name        = "redis"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}


// =============================================================================
// 7. RabbitMQ metrics
//
// Requires rabbitmq_prometheus to be enabled.
// =============================================================================

prometheus.scrape "rabbitmq" {
  targets = [
    {
      "__address__" = "rabbitmq:15692",
      "instance"    = "rabbitmq",
      "environment" = "docker",
      "application" = "wispurl",
    },
  ]

  job_name        = "rabbitmq"
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

// /metrics above only has broker-wide totals. Per-queue depth and consumer
// counts (needed to alert on the dead-letter queue) live on /metrics/detailed.
prometheus.scrape "rabbitmq_queues" {
  targets = [
    {
      "__address__" = "rabbitmq:15692",
      "instance"    = "rabbitmq",
      "environment" = "docker",
      "application" = "wispurl",
    },
  ]

  job_name        = "rabbitmq-queues"
  metrics_path    = "/metrics/detailed"
  params          = {
    "family" = ["queue_coarse_metrics", "queue_consumer_count"],
  }
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}


// =============================================================================
// 8. PostgreSQL metrics
//
// The DSN comes from the Docker secret observability/secrets/postgres_dsn.txt
// and logs in as wispurl_monitor, a read-only role with pg_monitor only
// (created by db/init/create-monitoring-role.sh). The file must not end in a
// newline, or the exporter fails to parse it.
// =============================================================================

local.file "postgres_dsn" {
  filename  = "/run/secrets/postgres_dsn"
  is_secret = true
}

prometheus.exporter.postgres "postgres" {
  data_source_names = [local.file.postgres_dsn.content]
}

prometheus.scrape "postgres" {
  targets         = prometheus.exporter.postgres.postgres.targets
  job_name        = "postgres"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}


// =============================================================================
// 9. Host and container metrics (USE: utilization, saturation, errors)
//
// The node exporter reads the host's /proc, /sys and / (mounted read-only
// under /host). On Docker Desktop the "host" is Docker's Linux VM.
// =============================================================================

prometheus.exporter.unix "host" {
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  rootfs_path    = "/host/root"
  udev_data_path = "/host/root/run/udev/data"
}

// The exporter's default instance is Alloy's container hostname, which changes
// every time Alloy is recreated. A fixed name keeps one continuous series.
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "instance"
    replacement  = "docker-host"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  job_name        = "node"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

// cAdvisor: CPU, memory and network per container, via the Docker socket.
prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "2m"
}

discovery.relabel "containers" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    target_label = "instance"
    replacement  = "docker-host"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.containers.output
  job_name        = "cadvisor"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}
